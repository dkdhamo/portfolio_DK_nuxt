# ─── Turso (SQLite cloud DB) ────────────────────────────────
# Get from: https://turso.tech  → Create account → turso db create portfolio-dk
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── GitHub OAuth ────────────────────────────────────────────
# Create at: github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:      https://your-domain.com
#   Callback URL:      https://your-domain.com/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Your GitHub username — only this account can access /admin
ADMIN_GITHUB_LOGIN=your-github-username

# ─── Resend (email for contact form) ────────────────────────
# Get from: https://resend.com → Create account → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email where contact form submissions are sent
CONTACT_RECIPIENT_EMAIL=webtechians.dev@gmail.com

# ─── Session secret (any random 32+ char string) ────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=your-random-32-char-secret-here
